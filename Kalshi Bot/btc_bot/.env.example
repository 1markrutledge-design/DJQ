# ─────────────────────────────────────────────────────────────────
# Kalshi BTC Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Then run:  source .env && python bot.py
# ─────────────────────────────────────────────────────────────────

# Your Kalshi API Key ID (from the Kalshi dashboard)
export KALSHI_API_KEY_ID="your-key-id-here"

# Path to your RSA private key file (relative or absolute)
# Leave KALSHI_PRIVATE_KEY_PEM unset and the bot will read from this file.
export KALSHI_PRIVATE_KEY_PATH="kalshi_private.pem"

# Alternatively, paste the PEM inline (useful for cloud deployments):
# export KALSHI_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Set to "true" to run in simulation mode (no real orders placed)
export DRY_RUN="false"

# Set to "true" for verbose debug logging
export DEBUG="false"
